<div class="entity-xfinitywifi-status">
    <div class="container">
        <div class="group-label">Connection</div>
        <div class="container nowrap">
            <div class="label">Status</div>
            {{if .Connected}}
                <div class="value status-ok">Connected</div>
            {{else}}
                <div class="value status-bad">Disconnected</div>
            {{end}}
        </div>
        <div class="container nowrap">
            <div class="label">Captive Portal</div>
            {{if .CaptivePortalDetected}}
                <div class="value status-bad">Detected</div>
            {{else}}
                <div class="value status-ok">None</div>
            {{end}}
        </div>
        <div class="container nowrap">
            <div class="label">Monitor</div>
            {{if .Running}}
                <div class="value status-ok">Running</div>
            {{else}}
                <div class="value status-bad">Stopped</div>
            {{end}}
        </div>
    </div>
    <div class="container">
        <div class="group-label">Account</div>
        <div class="container nowrap">
            <div class="label">Username</div>
            <div class="value monospace">{{if ne .Username ""}}{{.Username}}{{else}}(not configured){{end}}</div>
        </div>
        <div class="container nowrap">
            <div class="label">Check Interval</div>
            <div class="value">{{.CheckInterval}}</div>
        </div>
    </div>
    <div class="container">
        <div class="group-label">Checks</div>
        <div class="container nowrap">
            <div class="label">Total</div>
            <div class="value">{{.TotalChecks}}</div>
        </div>
        <div class="container nowrap">
            <div class="label">Connected</div>
            <div class="value">{{.TotalConnectedChecks}}</div>
        </div>
        <div class="container nowrap">
            <div class="label">Last Check</div>
            {{if .LastCheckTime.IsZero}}
                <div class="timestamp">Never</div>
            {{else}}
                <div class="timestamp">{{.LastCheckTime.Format "2006-01-02 3:04:05 PM"}}</div>
            {{end}}
        </div>
    </div>
    <div class="container">
        <div class="group-label">Re-auth</div>
        <div class="container nowrap">
            <div class="label">Attempts</div>
            <div class="value">{{.TotalReauthAttempts}}</div>
        </div>
        <div class="container nowrap">
            <div class="label">Successes</div>
            <div class="value">{{.TotalReauthSuccesses}}</div>
        </div>
    </div>
    <div class="container">
        <div class="group-label">Last Error</div>
        <div class="container nowrap">
            <div class="label">Time</div>
            <div class="timestamp">
                {{if .LastErrorTime.IsZero}}
                    Never
                {{else}}
                    {{.LastErrorTime.Format "2006-01-02 3:04:05 PM"}}
                {{end}}
            </div>
            {{if not .LastErrorTime.IsZero}}
                <div class="value monospace">{{.LastErrorMessage}}</div>
            {{end}}
        </div>
    </div>
</div>
